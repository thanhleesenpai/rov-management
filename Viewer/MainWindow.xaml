<Window x:Class="Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sonar Viewer"
        Width="960" Height="700"
        MinWidth="800" MinHeight="600"
        Background="#0a0a0a"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background"       Value="#1c1c1c"/>
            <Setter Property="Foreground"       Value="#d0d0d0"/>
            <Setter Property="BorderBrush"      Value="#2e2e2e"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontFamily"       Value="Consolas"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="Padding"          Value="12,6"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"  Value="#262626"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#444"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#333"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background"  Value="#0d2b0d"/>
            <Setter Property="BorderBrush" Value="#1a5c1a"/>
            <Setter Property="Foreground"  Value="#6dff6d"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="#1c1c1c"/>
            <Setter Property="Foreground"      Value="#d0d0d0"/>
            <Setter Property="BorderBrush"     Value="#2e2e2e"/>
            <Setter Property="FontFamily"      Value="Consolas"/>
            <Setter Property="FontSize"        Value="12"/>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#606060"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#c0c0c0"/>
            <Setter Property="FontFamily"  Value="Consolas"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LblGreen" TargetType="TextBlock" BasedOn="{StaticResource Val}">
            <Setter Property="Foreground" Value="#6dff6d"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background"   Value="#111"/>
            <Setter Property="BorderBrush"  Value="#222"/>
            <Setter Property="Foreground"   Value="#ccc"/>
            <Setter Property="FontFamily"   Value="Consolas"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding"     Value="8,6"/>
            <Setter Property="BorderBrush" Value="#1a1a1a"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1a3a1a"/>
                    <Setter Property="Foreground" Value="#6dff6d"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1e1e1e"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Slider ── -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#1a5c1a"/>
        </Style>

        <!-- ── CheckBox ── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════
             LEFT PANEL — danh sách file
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="0" Background="#0e0e0e">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#141414"
                    BorderBrush="#1e1e1e" BorderThickness="0,0,0,1"
                    Padding="12,10">
                <StackPanel>
                    <TextBlock Text="SONAR VIEWER"
                               Foreground="#6dff6d" FontFamily="Consolas"
                               FontSize="13" FontWeight="Bold" />
                    <TextBlock x:Name="FolderLabel"
                               Text="Chưa chọn thư mục"
                               Foreground="#444" FontFamily="Consolas"
                               FontSize="10" TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Nút chọn thư mục -->
            <Button Grid.Row="1"
                Style="{StaticResource Btn}"
                Margin="8,8,8,4"
                Click="OnBrowseFolderClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons"
                       Text="&#xE8B7;"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
                    <TextBlock Text="Chọn thư mục"
                   VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Danh sách file -->
            <ListBox Grid.Row="2" x:Name="FileListBox"
                     Margin="0,4,0,0"
                     SelectionChanged="OnFileSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="{Binding FileName}"
                                       FontFamily="Consolas" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal"
                                        Margin="0,2,0,0">
                                <TextBlock Text="{Binding DurationDisplay}"
                                           Foreground="#555" FontSize="10"
                                           FontFamily="Consolas" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding FileSizeDisplay}"
                                           Foreground="#555" FontSize="10"
                                           FontFamily="Consolas" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding FrameCount, StringFormat={}{0:N0} fr}"
                                           Foreground="#444" FontSize="10"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="3"
                Style="{StaticResource Btn}"
                Margin="8,4,8,8"
                Click="OnRefreshClick">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe Fluent Icons"
                       Text="&#xE72C;"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="0,0,6,0"/>
                    <TextBlock Text="Làm mới"
                   VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <GridSplitter Grid.Column="1"
                      Width="4" HorizontalAlignment="Stretch"
                      Background="#181818"/>

        <!--RIGHT PANEL — sonar + controls -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- toolbar -->
                <RowDefinition Height="*"/>      <!-- sonar -->
                <RowDefinition Height="Auto"/>   <!-- progress -->
                <RowDefinition Height="Auto"/>   <!-- controls -->
                <RowDefinition Height="Auto"/>   <!-- status bar -->
            </Grid.RowDefinitions>

            <!--Toolbar -->
            <Grid Grid.Row="0" Background="#101010"
                  Margin="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- File đang phát -->
                <StackPanel Grid.Column="0" Orientation="Vertical"
                            VerticalAlignment="Center" Margin="12,8">
                    <TextBlock x:Name="NowPlayingLabel"
                               Text="—" Foreground="#aaa"
                               FontFamily="Consolas" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="FrameCountLabel"
                                   Style="{StaticResource Lbl}" Margin="0,0,12,0"/>
                        <TextBlock x:Name="TotalDurationLabel"
                                   Style="{StaticResource Lbl}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Range -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="4,0,8,0">
                    <Button Content="−" Style="{StaticResource Btn}"
                            Width="28" Padding="0"
                            Click="OnDecreaseRange"/>
                    <TextBlock x:Name="RangeLabel"
                               Style="{StaticResource LblGreen}"
                               MinWidth="60" TextAlignment="Center"
                               Margin="6,0" FontSize="12"/>
                    <Button Content="+" Style="{StaticResource Btn}"
                            Width="28" Padding="0"
                            Click="OnIncreaseRange"/>
                </StackPanel>

                <!-- Color mode -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Color:" Style="{StaticResource Lbl}"
                               Margin="0,0,5,0"/>
                    <ComboBox x:Name="ColorCombo" Width="100"
                              SelectedIndex="0"
                              SelectionChanged="OnColorChanged">
                        <ComboBoxItem Content="Heatmap"/>
                        <ComboBoxItem Content="Green Radar"/>
                        <ComboBoxItem Content="White"/>
                        <ComboBoxItem Content="Yellow"/>
                    </ComboBox>
                </StackPanel>

                <!-- Speed -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="Speed:" Style="{StaticResource Lbl}"
                               Margin="0,0,5,0"/>
                    <ComboBox x:Name="SpeedCombo" Width="70"
                              SelectedIndex="1"
                              SelectionChanged="OnSpeedChanged">
                        <ComboBoxItem Content="0.25×"/>
                        <ComboBoxItem Content="1×"/>
                        <ComboBoxItem Content="2×"/>
                        <ComboBoxItem Content="4×"/>
                        <ComboBoxItem Content="8×"/>
                    </ComboBox>
                </StackPanel>

                <!-- Loop -->
                <CheckBox Grid.Column="4" x:Name="LoopCheckBox"
                          Content="Loop" Margin="0,0,12,0"/>
            </Grid>

            <!-- ── Sonar display ── -->
            <Border Grid.Row="1"
                    Background="Black"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid Width="512" Height="512">
                    <!-- Sonar image -->
                    <Image x:Name="SonarImage"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Stretch="None"/>
                    <!-- Grid overlay -->
                    <Canvas x:Name="GridCanvas" IsHitTestVisible="False"/>
                    <!-- Empty state overlay -->
                    <Border x:Name="EmptyOverlay"
                            Background="#CC000000"
                            Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe Fluent Icons"
                                       Text="&#xE909;"
                                       Foreground="#2a4a2a"
                                       FontSize="64"
                                       HorizontalAlignment="Center"/>   
                            <TextBlock Text="Chọn file để phát"
                                       Foreground="#3a5a3a"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Progress bar -->
            <Grid Grid.Row="2" Margin="12,6,12,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CurrentTimeLabel"
                           Grid.Column="0" Text="00:00"
                           Style="{StaticResource Lbl}"
                           TextAlignment="Left"/>

                <Slider Grid.Column="1" x:Name="ProgressSlider"
                        Minimum="0" Maximum="100" Value="0"
                        IsEnabled="False"
                        VerticalAlignment="Center"
                        ValueChanged="OnProgressSliderChanged"
                        PreviewMouseDown="OnSliderMouseDown"
                        PreviewMouseUp="OnSliderMouseUp"/>

                <TextBlock x:Name="EndTimeLabel"
                           Grid.Column="2" Text="00:00"
                           Style="{StaticResource Lbl}"
                           TextAlignment="Right"/>
            </Grid>

            <!--  Playback controls -->
            <Grid Grid.Row="3" Margin="12,4,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BtnPlayPause"
                    Style="{StaticResource BtnAccent}"
                    Width="100" IsEnabled="False"
                    Click="OnPlayPauseClick"
                    Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="IconPlayPause"
                               FontFamily="Segoe Fluent Icons"
                               Text="&#xE768;"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>   
                        <TextBlock x:Name="LabelPlayPause"
                   Text="Play"
                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" x:Name="BtnStop"
                    Style="{StaticResource Btn}"
                    Width="90" IsEnabled="False"
                    Click="OnStopClick"
                    Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="Segoe Fluent Icons"
                               Text="&#xE71A;"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                        <TextBlock Text="Stop" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" x:Name="BtnStepBack"
                    Style="{StaticResource Btn}"
                    Width="50" IsEnabled="False"
                    Click="OnStepBack"
                    Margin="0,0,6,0">
                    <TextBlock FontFamily="Segoe Fluent Icons"
                               Text="&#xE892;"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                </Button>

                <Button Grid.Column="4" x:Name="BtnStepForward"
                    Style="{StaticResource Btn}"
                    Width="50" IsEnabled="False"
                    Click="OnStepForward">
                    <TextBlock FontFamily="Segoe Fluent Icons"
                               Text="&#xE893;"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- ── Status bar ── -->
            <Border Grid.Row="4"
                    Background="#0e0e0e"
                    BorderBrush="#1a1a1a" BorderThickness="0,1,0,0"
                    Padding="12,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusLabel"
                               Grid.Column="0"
                               Text="Sẵn sàng"
                               Style="{StaticResource Lbl}"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Frame: " Style="{StaticResource Lbl}"/>
                        <TextBlock x:Name="FrameIndexLabel"
                                   Text="—" Style="{StaticResource Val}"
                                   Margin="0,0,12,0"/>
                        <TextBlock Text="FPS: " Style="{StaticResource Lbl}"/>
                        <TextBlock x:Name="FpsLabel"
                                   Text="—" Style="{StaticResource Val}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
